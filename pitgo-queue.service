[Unit]
Description=PitGO Laravel Queue Worker
After=network.target postgresql.service pitgo-php.service

[Service]
Type=simple
User=mannn
WorkingDirectory=/home/mannn/PitGO
ExecStart=/usr/bin/php artisan queue:work --tries=3 --timeout=90
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PATH=/home/mannn/.nvm/versions/node/v24.14.1/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
