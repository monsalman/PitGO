[Unit]
Description=PitGO Laravel PHP Server
After=network.target postgresql.service

[Service]
Type=simple
User=mannn
WorkingDirectory=/home/mannn/PitGO
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PATH=/home/mannn/.nvm/versions/node/v24.14.1/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
