# Build stage
FROM node:20-alpine AS frontend-builder
WORKDIR /app

# Copy all necessary files
COPY package.json package-lock.json ./
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public

# Install dependencies
RUN npm ci --legacy-peer-deps

# Build frontend
RUN npm run build

# PHP production stage - using Debian for better compatibility
FROM php:8.2-fpm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    sqlite3 \
    curl \
    zip \
    unzip \
    git \
    supervisor \
    nginx \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install pdo pdo_sqlite bcmath

# Install PostgreSQL driver
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev && \
    docker-php-ext-install pdo_pgsql && \
    apt-get remove -y libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Redis
RUN pecl install redis && docker-php-ext-enable redis

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy application files
COPY . .

# Copy built frontend
COPY --from=frontend-builder /app/public/build ./public/build
COPY --from=frontend-builder /app/node_modules ./node_modules

# Install PHP dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-ansi

# Set permissions
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache

# Copy supervisor config
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy nginx config
COPY nginx.conf /etc/nginx/http.d/default.conf

# Expose ports
EXPOSE 8000 6001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
